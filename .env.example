# Copie para .env e ajuste os valores:  cp .env.example .env
# O .env NAO vai para o repositorio (esta no .gitignore). Aqui ficam so exemplos, nunca senhas reais.

# ---- Banco de dados (PostgreSQL) ----
POSTGRES_DB=codigo_vermelho
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# ---- API ----
# Porta publica da API no host (container sempre expoe 8080 internamente)
API_PORT=8080

# ---- Grafana (obrigatorio trocar: a senha padrao admin/admin nao e aceita no projeto) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
GRAFANA_PORT=3000
# URL publica pela qual o professor acessa (ex.: https://grafana.seudominio.com ou http://IP-DA-VM:3000)
GRAFANA_ROOT_URL=http://localhost:3000

# Usuario de leitura (papel Viewer) do professor, criado com scripts/criar-usuario-viewer.sh
VIEWER_LOGIN=professor
VIEWER_PASSWORD=troque-esta-senha

# ---- Prometheus (publicado so em 127.0.0.1) ----
PROMETHEUS_PORT=9090

# ---- Gerador de carga ----
CARGA_INTERVALO_SEGUNDOS=2
