# Copie para .env e ajuste os valores:  cp .env.example .env
# O .env NAO vai para o repositorio (esta no .gitignore).

# ---- Banco de dados (PostgreSQL) ----
POSTGRES_DB=codigo_vermelho
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# ---- API ----
# Porta publica da API no host (container sempre expoe 8080 internamente)
API_PORT=8080
