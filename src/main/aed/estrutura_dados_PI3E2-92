#include <string>
using namespace std;

// Representa uma unidade individual de sangue coletada
struct Bolsa {
    string idBolsa;
    string tipoSanguineo;      // ex: "O+", "A-", "AB+"
    string dataColeta;         // formato "AAAA-MM-DD"
    string dataValidade;       // formato "AAAA-MM-DD"
    string idUnidadeAtual;     // idUnidade onde a bolsa esta guardada
    string status;             // "Disponivel", "Reservada", "Utilizada", "Vencida"
};

// Representa um pedido de bolsas de uma unidade para outra
struct Requisicao {
    string idRequisicao;
    string idUnidadeSolicitante;  // quem esta pedindo (ex: um hospital)
    string idUnidadeFornecedora;  // quem vai atender o pedido (ex: um hemocentro)
    string tipoSanguineoSolicitado;
    int quantidadeSolicitada;
    string dataRequisicao;
    string status;              // "Pendente", "Atendida", "Cancelada"
};

// Representa o estoque agregado de um tipo sanguineo em uma unidade
// (mesmos dados ja usados no painel estatistico da US06)
struct EstoqueUnidade {
    string idUnidade;
    string tipoSanguineo;
    int qtdBolsasAtual;
    int estoqueMinimoSeguranca;
    double consumoDiarioMedio;
};